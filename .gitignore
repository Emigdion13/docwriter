# Virtual environment
.venv/

# Node
node_modules/

# Built frontend (generated by "npm run build" in frontend/)
src/vaultnotes/web/

# Packaging output
build/
dist/
# The icon files are generated from the design logo by packaging/make_icon.py
packaging/vaultnotes.png
packaging/vaultnotes.ico

# Key files must never be committed
*.vnkey

# Python cruft
__pycache__/
*.py[cod]
.pytest_cache/

# PyInstaller writes this spec file on every build (build.bat passes all options)
VaultNotes.spec
